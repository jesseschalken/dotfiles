#!/usr/bin/env python3
import os
import stat
import sys

UMASK = 0o022


def fix_permissions(path: str):
    mode = os.lstat(path).st_mode
    exec = False

    if stat.S_ISDIR(mode):
        for entry in os.listdir(path):
            fix_permissions(os.path.join(path, entry))
        exec = True
    elif stat.S_ISREG(mode):
        with open(path, "rb") as f:
            head = f.read(10)
        exec = any(
            head.startswith(m)
            for m in [
                b"#!",
                b"\x7fELF",
                b"\xfe\xed\xfa\xce",
                b"\xfe\xed\xfa\xcf",
                b"\xca\xfe\xba\xbe",
                b"MZ",
                b"PE\x00\x00",
            ]
        )
    elif stat.S_ISLNK(mode):
        return

    mask = 0o777 if exec else 0o666
    new = (~UMASK) & mask
    old = mode & 0o777

    if old != new:
        print(f"{oct(old)} => {oct(new)}  {path}")
        os.chmod(path, new)


for p in sys.argv[1:]:
    fix_permissions(p)
