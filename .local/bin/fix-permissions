#!/usr/bin/env php
<?php

$umask = 0022;

function fix_permissions($path) {
    global $umask;

    $type = filetype($path);
    $exec = false;

    if ($type === 'dir') {
        foreach (array_diff(scandir($path), ['.', '..']) as $p) {
            fix_permissions($path . DIRECTORY_SEPARATOR . $p);
        }
        $exec = true;
    } else if ($type === 'file') {
        $top = file_get_contents($path, false, null, 0, 10);
        if (
            substr($top, 0, 2) === '#!' ||
            substr($top, 0, 4) === "\x7fELF" ||
            substr($top, 0, 4) === "\xfe\xed\xfa\xce" ||
            substr($top, 0, 4) === "\xfe\xed\xfa\xcf" ||
            substr($top, 0, 4) === "\xca\xfe\xba\xbe" ||
            substr($top, 0, 2) === "MZ" ||
            substr($top, 0, 4) === "PE\x00\x00"
        ) {
            $exec = true;
        }
    } else if ($type === 'link') {
        return;
    }

    $new = ~$umask & ($exec ? 0777 : 0666);
    $old = fileperms($path) & 0777;

    if ($old !== $new) {
        print decoct($old) . ' => ' . decoct($new) . "  $path\n";
        chmod($path, $new);
    }
}

foreach (array_slice($argv, 1) as $path) {
    fix_permissions($path);
}

