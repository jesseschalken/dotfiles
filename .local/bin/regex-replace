#!/usr/bin/env python3

import sys
import re

CLEAR = "\r\x1b[2K"

regex = input("regex:\n")
replace = input("replacement:\n")
pattern = re.compile(regex, re.DOTALL)

files = sys.argv[1:]
count = len(files)

num = 0
for i, path in enumerate(files):
    print(f"{CLEAR}{i}/{count}: {path}", end="", flush=True)

    with open(path, "r", encoding="utf-8") as fh:
        contents = fh.read()

    new_contents, num_ = pattern.subn(replace, contents)
    num += num_

    if contents != new_contents:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(new_contents)

print(f"{CLEAR}{num} replacements across {count} files")
