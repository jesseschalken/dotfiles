#!/usr/bin/env python3
import os
import stat
import sys


def do_scan(path, dev):
    total = 1
    st = os.lstat(path)
    if stat.S_ISDIR(st.st_mode) and st.st_dev == dev:
        for entry in os.listdir(path):
            total += do_scan(os.path.join(path, entry), dev)
        print(f"{total}\t{path}")
    return total


for arg in sys.argv[1:]:
    do_scan(arg, os.lstat(arg).st_dev)
